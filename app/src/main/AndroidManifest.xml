<?xml version="1.0" encoding="utf-8"?>
<manifest package="it.vijay.exam"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:label="@string/app_name"
            android:theme="@style/AppTheme.NoActionBar.NoTranslucent2">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".Test.Questions"
            android:label="Questions"
            android:parentActivityName=".MainActivity"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBar">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value="it.vijay.exam.MainActivity" />
        </activity>

        <activity
            android:name=".Test.Result"
            android:label="Result" />
        <activity
            android:name=".Test.ScoreCard"
            android:label="High Score"
            android:parentActivityName=".MainActivity"
            android:theme="@style/AppTheme.NoActionBar">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value="it.vijay.exam.MainActivity" />
        </activity>

        <activity
            android:name=".EnableDisableItemsActivity"
            android:theme="@style/AppTheme.NoActionBar">

        </activity>

        <activity
            android:name=".MainActivityNoHide"
            android:label="@string/app_name"
            android:theme="@style/AppTheme.NoActionBar.NoTranslucent2" />

        <activity
            android:name=".MainActivityTablet"
            android:label="@string/app_name_tablet"
            android:theme="@style/AppTheme.NoActionBar.NoTranslucent">

        </activity>

        <activity
            android:name=".MainActivityTabletCollapsedToolbar"
            android:label="@string/app_name_tablet"
            android:theme="@style/AppTheme.NoActionBar.NoTranslucent2">

        </activity>

    </application>

</manifest>